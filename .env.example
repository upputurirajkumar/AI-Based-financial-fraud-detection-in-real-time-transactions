# Django Secret Key (Never expose real secrets in source control)
SECRET_KEY=django-insecure-audit-phase2-fraud-detection-secret-key-2026

# Debug mode (True for development, False for production)
DEBUG=True

# Allowed hosts (comma-separated list)
ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0,.run.app

# Database URL (defaults to SQLite; supports PostgreSQL in production)
DATABASE_URL=sqlite:///db.sqlite3

# Directory where serialized ML model artifacts are stored
MODEL_DIR=model

# Uploaded media storage
MEDIA_ROOT=media
MEDIA_URL=/media/

# Upload file size limit in bytes (10MB limit: 10485760 bytes)
MAX_UPLOAD_SIZE=10485760
